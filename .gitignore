# ==============================================================================
# Mashrue Production Git Exclusion Rules
# ==============================================================================

# Node.js dependencies (Install on target server via npm ci)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.local

# Certificates, Keys & Credentials
*.pem
*.key
*.crt
*.pfx

# Build outputs & caches
dist/
build/
.cache/
coverage/

# IDE & Operating System metadata
.vscode/
.idea/
.gemini/
.DS_Store
Thumbs.db

# Logs & Dumps
logs/
*.log
/var/log/
/var/backups/
*.sql.gz
*.tmp
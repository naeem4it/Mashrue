# ==============================================================================
# Mashrue (mashrue.com) — Production Environment Variables Template
# Copy this file to .env on your production server: cp .env.example .env
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3033

# PostgreSQL 16+ Production Database Connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mashrueDB
DB_USER=mashrue_user
DB_PASSWORD=your_strong_production_database_password_here

# JWT Secret Key (Generate with: openssl rand -base64 48)
JWT_SECRET=your_super_secure_random_jwt_secret_key_min_32_characters

# Production Domain CORS Whitelist (Comma-separated)
ALLOWED_ORIGINS=https://mashrue.com,https://www.mashrue.com

# Pakistan FBR / PRAL Digital Invoicing Gateway (Specs v1.12)
# Set to 'Production' when live PRAL credentials are provided
FBR_ENVIRONMENT=Sandbox
FBR_SANDBOX_URL=https://gw.fbr.gov.pk/di_data/v1/di/postinvoicedata_sb
FBR_PRODUCTION_URL=https://gw.fbr.gov.pk/di_data/v1/di/postinvoicedata
FBR_VALIDATE_SANDBOX_URL=https://gw.fbr.gov.pk/di_data/v1/di/validateinvoicedata_sb
FBR_VALIDATE_PRODUCTION_URL=https://gw.fbr.gov.pk/di_data/v1/di/validateinvoicedata

# PRAL Digital Invoicing Credentials (Provided by FBR)
FBR_BEARER_TOKEN=your_pral_bearer_token_here
FBR_SELLER_NTN=your_company_fbr_ntn_here
